{
  "port": "8080",
  "http-timeout-seconds": 30,
  "rate-limit": 120,
  "ws-port": 8092,
  "cors": "",
  "trusted-proxies": "",

  "api-base-url": { "DualStack": [], "IPv4": [], "IPv6": [] },
  "ip-location-api": [],
  "api-keys": {},
  "ws-keys": {},

  "database": { "driver": "sqlite", "dsn": "boce.db" },
  "admin-token": "",
  "jwt-secret": "change-me-to-a-long-random-string",
  "jwt-expiry-seconds": 86400,
  "admin-user": "admin",
  "admin-password": "",
  "report-token": "",
  "registration-enabled": true,
  "ws-require-key": false,
  "data-retention-days": 30,
  "user-task-limit": 20,
  "user-min-interval": 0,

  "web-dir": "web/dist",
  "public-ws-url": "",
  "ota-asset-base": "",

  "smtp": { "host": "", "port": 465, "user": "", "password": "", "from": "", "fromName": "", "ssl": true, "startTLS": false, "insecure": false, "timeoutSec": 10 },
  "alert": { "enabled": true, "downThreshold": 3 }
}
